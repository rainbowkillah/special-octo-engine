{
	"name": "environmenthub-stg",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENV": "stg"
	},
	// D1 Database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "environmenthub-stg",
			"database_id": "1da3307c-452a-4f30-a7ea-f4d9359a0af5"
		}
	],
	// KV for caching
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "a7ea2dc40b784ed797c377c87735b56e"
		}
	],
	// Observability
	"observability": {
		"enabled": true
	}
	// Secrets (set via wrangler secret put)
	// - CF_ACCESS_TEAM_NAME
	// - CF_ACCESS_AUD
	// Routes (uncomment and configure for custom domain)
	// "routes": [
	//   {
	//     "pattern": "environmenthub-stg.yourdomain.com/*",
	//     "custom_domain": true
	//   }
	// ]
}