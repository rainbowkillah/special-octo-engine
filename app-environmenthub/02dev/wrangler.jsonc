{
	"name": "environmenthub-dev",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-03",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"vars": {
		"ENV": "dev"
	},
	// D1 Database binding
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "environmenthub-dev",
			"database_id": "14bf17c9-c510-4ed7-80f7-6c002eb68e0f"
		}
	],
	// KV for caching (optional but recommended)
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "dcdd1cd9381b4a839bb0cd70e3f38b90"
		}
	],
	// Scheduled sync every 15 minutes (rapid iteration in dev)
	"triggers": {
		"crons": [
			"*/15 * * * *"
		]
	},
	// Observability
	"observability": {
		"enabled": true
	}
	// Secrets (set via wrangler secret put)
	// - NOTION_API_KEY
	// - NOTION_DATABASE_ID
	// - CF_ACCESS_TEAM_NAME
	// - CF_ACCESS_AUD
	// Routes (uncomment and configure for custom domain)
	// "routes": [
	//   {
	//     "pattern": "environmenthub-dev.yourdomain.com/*",
	//     "custom_domain": true
	//   }
	// ]
}